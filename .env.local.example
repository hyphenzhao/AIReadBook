# MySQL database used by Prisma
DATABASE_URL=mysql://aireadbook:change-me@localhost:3306/aireadbook

# Long random value used to sign the HTTP-only login cookie
AUTH_SECRET=replace-with-at-least-32-random-characters
# Set to true only when the site is served over HTTPS
AUTH_COOKIE_SECURE=false

# Server-side fallback used when an account has no personal AI key
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
