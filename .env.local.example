# MySQL database used by Prisma
DATABASE_URL=mysql://aireadbook:change-me@localhost:3306/aireadbook

# Required. Signs the HTTP-only login cookie and derives the key that encrypts
# stored API keys. Generate with: openssl rand -base64 48
# Changing it logs everyone out and makes saved API keys unreadable.
AUTH_SECRET=replace-with-at-least-32-random-characters
# Set to true only when the site is served over HTTPS
AUTH_COOKIE_SECURE=false

# Server-side fallback used when an account has no personal AI key.
# This key is only ever sent to DEEPSEEK_BASE_URL.
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Private-network AI endpoints users may point their Base URL at
# (comma-separated host or host:port). Everything else private is blocked.
LLM_ALLOWED_HOSTS=127.0.0.1:11434

# Embeddings (Ollama). Retrieval falls back to keyword search when unreachable.
EMBED_URL=http://127.0.0.1:11434
EMBED_MODEL=bge-m3
EMBED_FALLBACK_URL=

# Where uploaded PDFs and database backups live (outside the repository)
DATA_DIR=/var/lib/aireadbook
