# Lets the deploy script restart this one service without a password.
# Install with: visudo -cf deploy/aireadbook.sudoers && sudo install -m 0440 deploy/aireadbook.sudoers /etc/sudoers.d/aireadbook
haifeng ALL=(root) NOPASSWD: /usr/bin/systemctl start aireadbook, /usr/bin/systemctl stop aireadbook, /usr/bin/systemctl restart aireadbook, /usr/bin/systemctl status aireadbook
