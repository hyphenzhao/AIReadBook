generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int       @id @default(autoincrement())
  email     String    @unique @db.VarChar(255)
  name      String    @db.VarChar(100)
  password   String    @db.VarChar(255)  // hashed
  aiSettings Json?     @map("ai_settings")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  books       Book[]
  annotations Annotation[]
  reviewCards ReviewCard[]

  @@map("users")
}

model Book {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String    @db.VarChar(500)
  author    String?   @db.VarChar(300)
  coverUrl  String?   @db.Text @map("cover_url")
  language  String    @default("zh") @db.VarChar(10)
  chapters  Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  chaptersRel   Chapter[]
  annotations   Annotation[]
  chatSessions  ChatSession[]
  reviewCards   ReviewCard[]

  @@map("books")
}

model Chapter {
  id        Int       @id @default(autoincrement())
  bookId    Int       @map("book_id")
  book      Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  index     Int
  title     String?   @db.VarChar(500)
  content   String    @db.LongText
  wordCount Int       @default(0) @map("word_count")
  summary   String?   @db.Text

  annotations Annotation[]

  @@unique([bookId, index])
  @@map("chapters")
}

model Annotation {
  id           Int       @id @default(autoincrement())
  userId       Int       @map("user_id")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId       Int       @map("book_id")
  book         Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  chapterId    Int?      @map("chapter_id")
  chapter      Chapter?  @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  selectedText String    @db.Text @map("selected_text")
  note         String?   @db.Text
  color        String    @default("yellow") @db.VarChar(20)
  aiCategory   String?   @db.VarChar(100) @map("ai_category")
  aiSummary    String?   @db.Text @map("ai_summary")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@map("annotations")
}

model ChatSession {
  id        Int       @id @default(autoincrement())
  bookId    Int       @map("book_id")
  book      Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  chapterId Int?      @map("chapter_id")
  title     String    @db.VarChar(500)
  mode      String    @default("companion") @db.VarChar(20)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  messages ChatMessage[]

  @@map("chat_sessions")
}

model ChatMessage {
  id        Int         @id @default(autoincrement())
  sessionId Int         @map("session_id")
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String      @db.VarChar(20)
  content   String      @db.Text
  createdAt DateTime    @default(now()) @map("created_at")

  @@map("chat_messages")
}

model ReviewCard {
  id           Int       @id @default(autoincrement())
  userId       Int       @map("user_id")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId       Int       @map("book_id")
  book         Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  front        String    @db.Text
  back         String    @db.Text
  sourceType   String    @db.VarChar(20) @map("source_type")
  easeFactor   Float     @default(2.5) @map("ease_factor")
  interval     Int       @default(0)
  repetitions  Int       @default(0)
  nextReview   DateTime  @default(now()) @map("next_review")
  lastReview   DateTime? @map("last_review")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@map("review_cards")
}
