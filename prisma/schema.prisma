generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int       @id @default(autoincrement())
  email     String    @unique @db.VarChar(255)
  name      String    @db.VarChar(100)
  password   String    @db.VarChar(255)  // hashed
  aiSettings Json?     @map("ai_settings")
  role        UserRole  @default(USER)
  disabled    Boolean   @default(false)
  lastLoginAt DateTime? @map("last_login_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  books           Book[]
  annotations     Annotation[]
  reviewCards     ReviewCard[]
  chunks          Chunk[]
  knowledgeCards  KnowledgeCard[]
  graphNodes      GraphNode[]
  graphEdges      GraphEdge[]
  readingProgress ReadingProgress[]
  papers           Paper[]
  paperCollections PaperCollection[]
  paperTags        Tag[]
  paperLinks       PaperLink[]
  paperAnnotations PaperAnnotation[]

  @@map("users")
}

enum UserRole {
  ADMIN
  USER
}

/// Instance-wide settings edited by admins (registration switch, search API keys, ...).
model AppSetting {
  key       String   @id @db.VarChar(100)
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

model Book {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String    @db.VarChar(500)
  author    String?   @db.VarChar(300)
  coverUrl  String?   @db.Text @map("cover_url")
  language  String    @default("zh") @db.VarChar(10)
  chapters  Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  chaptersRel     Chapter[]
  annotations     Annotation[]
  chatSessions    ChatSession[]
  reviewCards     ReviewCard[]
  chunks          Chunk[]
  knowledgeCards  KnowledgeCard[]
  graphMentions   GraphMention[]
  readingProgress ReadingProgress[]

  @@map("books")
}

model Chapter {
  id        Int       @id @default(autoincrement())
  bookId    Int       @map("book_id")
  book      Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  index     Int
  title     String?   @db.VarChar(500)
  content   String    @db.LongText
  wordCount Int       @default(0) @map("word_count")
  summary      String?   @db.Text
  summaryModel String?   @db.VarChar(200) @map("summary_model")
  summaryAt    DateTime? @map("summary_at")

  annotations    Annotation[]
  chunks         Chunk[]
  knowledgeCards KnowledgeCard[]
  graphMentions  GraphMention[]

  @@unique([bookId, index])
  @@fulltext([title, content], map: "ft_chapter_content")
  @@map("chapters")
}

model Annotation {
  id           Int       @id @default(autoincrement())
  userId       Int       @map("user_id")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId       Int       @map("book_id")
  book         Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  chapterId    Int?      @map("chapter_id")
  chapter      Chapter?  @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  selectedText String    @db.Text @map("selected_text")
  note         String?   @db.Text
  color        String    @default("yellow") @db.VarChar(20)
  aiCategory   String?   @db.VarChar(100) @map("ai_category")
  aiSummary    String?   @db.Text @map("ai_summary")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@map("annotations")
}

/// A conversation about a book or about a paper (exactly one of the two is set).
model ChatSession {
  id        Int       @id @default(autoincrement())
  bookId    Int?      @map("book_id")
  book      Book?     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  paperId   Int?      @map("paper_id")
  paper     Paper?    @relation(fields: [paperId], references: [id], onDelete: Cascade)
  chapterId Int?      @map("chapter_id")
  title     String    @db.VarChar(500)
  mode      String    @default("companion") @db.VarChar(20)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  messages ChatMessage[]

  @@map("chat_sessions")
}

model ChatMessage {
  id        Int         @id @default(autoincrement())
  sessionId Int         @map("session_id")
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String      @db.VarChar(20)
  content   String      @db.Text
  /// Sources the answer was grounded on (retrieval tier, chunks, web results).
  annotations Json?
  createdAt DateTime    @default(now()) @map("created_at")

  @@map("chat_messages")
}

model ReviewCard {
  id           Int       @id @default(autoincrement())
  userId       Int       @map("user_id")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId       Int       @map("book_id")
  book         Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  front        String    @db.Text
  back         String    @db.Text
  sourceType   String    @db.VarChar(20) @map("source_type")
  cardId       Int?      @map("card_id")
  easeFactor   Float     @default(2.5) @map("ease_factor")
  interval     Int       @default(0)
  repetitions  Int       @default(0)
  nextReview   DateTime  @default(now()) @map("next_review")
  lastReview   DateTime? @map("last_review")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@map("review_cards")
}

// ---------------------------------------------------------------------------
// Knowledge foundation shared by books and (later) papers.
// Cross-cutting tables carry real nullable foreign keys per source rather than
// a bare (type, id) pair, so cascading deletes and typed relations keep working.
// ---------------------------------------------------------------------------

enum SourceType {
  BOOK
  PAPER
}

/// Books and papers keep separate graphs.
enum GraphScope {
  BOOK
  PAPER
}

/// A retrieval unit: ~900 characters of a chapter (or paper section).
model Chunk {
  id         Int        @id @default(autoincrement())
  userId     Int        @map("user_id")
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceType SourceType @map("source_type")
  bookId     Int?       @map("book_id")
  book       Book?      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  chapterId  Int?       @map("chapter_id")
  chapter    Chapter?   @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  paperId    Int?       @map("paper_id")
  paper      Paper?     @relation(fields: [paperId], references: [id], onDelete: Cascade)
  /// Position within the chapter (or paper).
  ordinal    Int
  text       String     @db.MediumText
  section    String?    @db.VarChar(300)
  pageStart  Int?       @map("page_start")
  pageEnd    Int?       @map("page_end")
  /// Character offsets into the chapter text, for jumping back to the passage.
  charStart  Int        @map("char_start")
  charEnd    Int        @map("char_end")

  embedding      Embedding?
  knowledgeCards KnowledgeCard[]
  graphMentions  GraphMention[]

  @@index([bookId, chapterId, ordinal])
  @@index([paperId, ordinal])
  @@index([userId, sourceType])
  @@fulltext([text], map: "ft_chunk_text")
  @@map("chunks")
}

/// Kept apart from Chunk so text queries never drag 4 KB vectors along.
model Embedding {
  chunkId Int    @id @map("chunk_id")
  chunk   Chunk  @relation(fields: [chunkId], references: [id], onDelete: Cascade)
  model   String @db.VarChar(100)
  dim     Int
  /// Float32 little-endian, L2-normalised at write time (cosine == dot product).
  vec     Bytes  @db.Blob

  @@map("embeddings")
}

model KnowledgeCard {
  id         Int        @id @default(autoincrement())
  userId     Int        @map("user_id")
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceType SourceType @map("source_type")
  bookId     Int?       @map("book_id")
  book       Book?      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  chapterId  Int?       @map("chapter_id")
  chapter    Chapter?   @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  paperId    Int?       @map("paper_id")
  paper      Paper?     @relation(fields: [paperId], references: [id], onDelete: Cascade)
  chunkId    Int?       @map("chunk_id")
  chunk      Chunk?     @relation(fields: [chunkId], references: [id], onDelete: SetNull)
  cardType   String     @db.VarChar(20) @map("card_type")
  title      String     @db.VarChar(300)
  content    String     @db.Text
  /// Verbatim source sentence, verified against the text before saving.
  quote      String?    @db.Text
  tags       Json
  difficulty String     @default("intermediate") @db.VarChar(20)
  createdAt  DateTime   @default(now()) @map("created_at")

  @@index([userId, bookId])
  @@index([userId, paperId])
  @@map("knowledge_cards")
}

model GraphNode {
  id          Int        @id @default(autoincrement())
  userId      Int        @map("user_id")
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope       GraphScope
  type        String     @db.VarChar(30)
  name        String     @db.VarChar(200)
  /// NFKC + lowercase + punctuation stripped; the merge key.
  normName    String     @db.VarChar(200) @map("norm_name")
  description String?    @db.Text
  /// Embedding of "name: description", used to merge near-duplicates.
  vec         Bytes?     @db.Blob
  /// Set on the node that stands for a paper itself (type "paper").
  paperId     Int?       @unique @map("paper_id")
  paper       Paper?     @relation("PaperNode", fields: [paperId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  aliases  GraphAlias[]
  outEdges GraphEdge[]    @relation("EdgeSrc")
  inEdges  GraphEdge[]    @relation("EdgeDst")
  mentions GraphMention[]

  @@unique([userId, scope, type, normName])
  @@map("graph_nodes")
}

model GraphAlias {
  id        Int       @id @default(autoincrement())
  nodeId    Int       @map("node_id")
  node      GraphNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  normAlias String    @db.VarChar(200) @map("norm_alias")

  @@unique([nodeId, normAlias])
  @@index([normAlias])
  @@map("graph_aliases")
}

model GraphEdge {
  id       Int        @id @default(autoincrement())
  userId   Int        @map("user_id")
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope    GraphScope
  srcId    Int        @map("src_id")
  src      GraphNode  @relation("EdgeSrc", fields: [srcId], references: [id], onDelete: Cascade)
  dstId    Int        @map("dst_id")
  dst      GraphNode  @relation("EdgeDst", fields: [dstId], references: [id], onDelete: Cascade)
  relation String     @db.VarChar(60)
  weight   Float      @default(1)

  mentions GraphMention[]

  @@unique([srcId, dstId, relation])
  @@index([userId, scope])
  @@map("graph_edges")
}

/// Provenance: where in the text a node or edge was found.
model GraphMention {
  id         Int        @id @default(autoincrement())
  nodeId     Int?       @map("node_id")
  node       GraphNode? @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  edgeId     Int?       @map("edge_id")
  edge       GraphEdge? @relation(fields: [edgeId], references: [id], onDelete: Cascade)
  chunkId    Int?       @map("chunk_id")
  chunk      Chunk?     @relation(fields: [chunkId], references: [id], onDelete: SetNull)
  bookId     Int?       @map("book_id")
  book       Book?      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  chapterId  Int?       @map("chapter_id")
  chapter    Chapter?   @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  paperId    Int?       @map("paper_id")
  paper      Paper?     @relation(fields: [paperId], references: [id], onDelete: Cascade)
  /// 1-based PDF page, for paper mentions.
  page       Int?
  quote      String?    @db.Text
  confidence Float      @default(1)
  createdAt  DateTime   @default(now()) @map("created_at")

  @@index([nodeId])
  @@index([edgeId])
  @@index([chapterId])
  @@index([paperId])
  @@map("graph_mentions")
}

model ReadingProgress {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId    Int?     @map("book_id")
  book      Book?    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  paperId   Int?     @map("paper_id")
  paper     Paper?   @relation(fields: [paperId], references: [id], onDelete: Cascade)
  /// Books: { chapterIndex, ratio }. Papers: { page, scale, offsetRatio }.
  locator   Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, bookId])
  @@unique([userId, paperId])
  @@map("reading_progress")
}

enum JobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

/// Background work run by the in-process worker (src/lib/jobs).
model Job {
  id          Int       @id @default(autoincrement())
  userId      Int?      @map("user_id")
  type        String    @db.VarChar(50)
  payload     Json
  /// Set to skip enqueueing a second identical job while one is pending.
  dedupeKey   String?   @db.VarChar(200) @map("dedupe_key")
  status      JobStatus @default(QUEUED)
  stage       String?   @db.VarChar(100)
  progress    Int       @default(0)
  attempts    Int       @default(0)
  maxAttempts Int       @default(3) @map("max_attempts")
  runAfter    DateTime  @default(now()) @map("run_after")
  lockedBy    String?   @db.VarChar(100) @map("locked_by")
  heartbeatAt DateTime? @map("heartbeat_at")
  error       String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([status, runAfter])
  @@index([dedupeKey, status])
  @@map("jobs")
}

model WebSearchCache {
  id        Int      @id @default(autoincrement())
  provider  String   @db.VarChar(30)
  queryHash String   @db.VarChar(64) @map("query_hash")
  results   Json
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([provider, queryHash])
  @@map("web_search_cache")
}

// ---------------------------------------------------------------------------
// Papers: a research library, separate from books. It shares the knowledge
// foundation above (chunks, embeddings, cards, graph with scope = PAPER) but
// has its own domain tables, because what matters here is how papers relate.
// ---------------------------------------------------------------------------

enum PaperStatus {
  UNREAD
  READING
  READ
}

model Paper {
  id        Int         @id @default(autoincrement())
  userId    Int         @map("user_id")
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String      @db.VarChar(1000)
  /// string[]
  authors   Json
  year      Int?
  venue     String?     @db.VarChar(500)
  doi       String?     @db.VarChar(255)
  arxivId   String?     @db.VarChar(50) @map("arxiv_id")
  abstract  String?     @db.Text
  language  String?     @db.VarChar(10)
  status    PaperStatus @default(UNREAD)
  rating    Int?
  notes     String?     @db.Text
  pageCount Int         @default(0) @map("page_count")
  /// Where the one-time processing pipeline stands: UPLOADED, EXTRACTING,
  /// CHUNKING, EMBEDDING, ANALYZING, LINKING, READY — or NO_FILE, NEEDS_KEY, FAILED.
  pipelineStage String  @default("UPLOADED") @db.VarChar(40) @map("pipeline_stage")
  pipelineError String? @db.Text @map("pipeline_error")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  file            PaperFile?
  pages           PaperPage[]
  analysis        PaperAnalysis?
  chunks          Chunk[]
  collections     PaperCollectionItem[]
  tags            PaperTag[]
  linksA          PaperLink[]       @relation("LinkA")
  linksB          PaperLink[]       @relation("LinkB")
  chatSessions    ChatSession[]
  annotations     PaperAnnotation[]
  knowledgeCards  KnowledgeCard[]
  graphMentions   GraphMention[]
  graphNode       GraphNode?        @relation("PaperNode")
  readingProgress ReadingProgress[]

  @@index([userId, status])
  @@index([userId, doi])
  @@fulltext([title, abstract], map: "ft_paper_title_abstract")
  @@map("papers")
}

/// The original PDF, stored on disk outside the repository, content-addressed.
model PaperFile {
  paperId      Int    @id @map("paper_id")
  paper        Paper  @relation(fields: [paperId], references: [id], onDelete: Cascade)
  userId       Int    @map("user_id")
  sha256       String @db.VarChar(64)
  bytes        Int
  /// Relative to DATA_DIR.
  path         String @db.VarChar(500)
  originalName String @db.VarChar(500) @map("original_name")

  /// The same PDF uploaded twice by one user is the same paper.
  @@unique([userId, sha256])
  @@map("paper_files")
}

/// One PDF page, extracted once at upload. The viewer renders the original
/// PDF; this is what search, the AI and citation highlights read instead.
model PaperPage {
  id        Int     @id @default(autoincrement())
  paperId   Int     @map("paper_id")
  paper     Paper   @relation(fields: [paperId], references: [id], onDelete: Cascade)
  pageNo    Int     @map("page_no")
  width     Float
  height    Float
  /// Offset of this page's text within the paper's full text (pages joined by a blank line).
  charStart Int     @map("char_start")
  text      String  @db.MediumText
  /// gzip(JSON): [{ s, e, b: [x0, y0, x1, y1] }] — each text line's character
  /// range within `text` and its box in PDF points, origin top-left.
  layout    Bytes   @db.MediumBlob
  isOcr     Boolean @default(false) @map("is_ocr")

  @@unique([paperId, pageNo])
  @@map("paper_pages")
}

/// Structured reading of a paper: research question, methods, datasets,
/// findings, limitations, keywords — each with a verified quote.
model PaperAnalysis {
  paperId   Int      @id @map("paper_id")
  paper     Paper    @relation(fields: [paperId], references: [id], onDelete: Cascade)
  data      Json
  model     String   @db.VarChar(200)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("paper_analyses")
}

model PaperCollection {
  id        Int               @id @default(autoincrement())
  userId    Int               @map("user_id")
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String            @db.VarChar(200)
  parentId  Int?              @map("parent_id")
  parent    PaperCollection?  @relation("CollectionTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  PaperCollection[] @relation("CollectionTree")
  createdAt DateTime          @default(now()) @map("created_at")

  items PaperCollectionItem[]

  @@unique([userId, parentId, name])
  @@map("paper_collections")
}

model PaperCollectionItem {
  collectionId Int             @map("collection_id")
  collection   PaperCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  paperId      Int             @map("paper_id")
  paper        Paper           @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@id([collectionId, paperId])
  @@map("paper_collection_items")
}

model Tag {
  id     Int    @id @default(autoincrement())
  userId Int    @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name   String @db.VarChar(100)

  papers PaperTag[]

  @@unique([userId, name])
  @@map("tags")
}

model PaperTag {
  paperId Int   @map("paper_id")
  paper   Paper @relation(fields: [paperId], references: [id], onDelete: Cascade)
  tagId   Int   @map("tag_id")
  tag     Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([paperId, tagId])
  @@map("paper_tags")
}

/// A typed relation between two papers, always stored with paperAId < paperBId.
model PaperLink {
  id       Int    @id @default(autoincrement())
  userId   Int    @map("user_id")
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  paperAId Int    @map("paper_a_id")
  paperA   Paper  @relation("LinkA", fields: [paperAId], references: [id], onDelete: Cascade)
  paperBId Int    @map("paper_b_id")
  paperB   Paper  @relation("LinkB", fields: [paperBId], references: [id], onDelete: Cascade)
  /// SHARED_KEYWORD, SHARED_METHOD, SHARED_DATASET, SIMILAR, AGREES, CONTRADICTS, EXTENDS, CITES
  type     String @db.VarChar(30)
  score    Float  @default(0)
  /// What the link rests on: shared node names, or paired quotes from both papers.
  evidence Json
  /// AUTO (computed), LLM (judged from the findings), USER (added by hand)
  origin   String @default("AUTO") @db.VarChar(10)
  /// A link the user rejected; kept so it is not suggested again.
  dismissed Boolean @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([paperAId, paperBId, type])
  @@index([userId])
  @@map("paper_links")
}

/// A highlight or note on a PDF, anchored by page and rectangles in PDF points.
model PaperAnnotation {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  paperId      Int      @map("paper_id")
  paper        Paper    @relation(fields: [paperId], references: [id], onDelete: Cascade)
  page         Int
  /// [[x0, y0, x1, y1], ...]
  rects        Json
  selectedText String   @db.Text @map("selected_text")
  note         String?  @db.Text
  color        String   @default("yellow") @db.VarChar(20)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([paperId, page])
  @@map("paper_annotations")
}
